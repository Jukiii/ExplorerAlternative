<Window x:Class="ExplorerAlternative.Views.CommandPaletteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExplorerAlternative.ViewModels"
        Title="コマンドパレット"
        Height="420" Width="520"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox x:Name="QueryTextBox" Grid.Row="0" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8,6" FontSize="15" BorderThickness="0,0,0,1"
                 BorderBrush="{DynamicResource BorderBrush2}"
                 Background="Transparent" />

        <ListBox x:Name="ResultsListBox" Grid.Row="1" Margin="0,4,0,0" BorderThickness="0"
                 ItemsSource="{Binding FilteredCommands}" SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                 MouseLeftButtonUp="ResultsListBox_MouseLeftButtonUp">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CommandPaletteEntry}">
                    <TextBlock Text="{Binding Name}" Padding="8,6" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
