<Window x:Class="ExplorerAlternative.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExplorerAlternative.Models"
        Title="設定"
        Height="600" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 設定項目が増えてきたため、ジャンルごとにタブで分けて見やすくする。 -->
        <TabControl Grid.Row="0">
            <TabItem Header="外観">
                <StackPanel Margin="12">
                    <TextBlock Text="テーマ" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Theme" Content="ライト" Margin="0,0,16,0" VerticalAlignment="Center"
                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:AppTheme.Light}, Mode=OneWay}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppTheme.Light}" />
                        <RadioButton GroupName="Theme" Content="ダーク" Margin="0,0,16,0" VerticalAlignment="Center"
                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:AppTheme.Dark}, Mode=OneWay}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppTheme.Dark}" />
                        <RadioButton GroupName="Theme" Content="システムに合わせる" VerticalAlignment="Center"
                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:AppTheme.System}, Mode=OneWay}"
                                     Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppTheme.System}" />
                    </StackPanel>
                    <DockPanel Margin="0,16,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="アクティブペイン背景強調度" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider Minimum="0" Maximum="0.4" TickFrequency="0.02" Width="200" HorizontalAlignment="Left"
                                Value="{Binding ActivePaneHighlightOpacity}" />
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="タブ・ターミナル">
                <StackPanel Margin="12">
                    <TextBlock Text="スマートタブ（重複タブの抑制）" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="DuplicateTab" Content="常に新しいタブ" Margin="0,0,16,0" VerticalAlignment="Center"
                                     IsChecked="{Binding DuplicateTabBehavior, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:DuplicateTabBehavior.AlwaysNew}, Mode=OneWay}"
                                     Command="{Binding SetDuplicateTabBehaviorCommand}" CommandParameter="{x:Static models:DuplicateTabBehavior.AlwaysNew}" />
                        <RadioButton GroupName="DuplicateTab" Content="既存タブを再利用" Margin="0,0,16,0" VerticalAlignment="Center"
                                     IsChecked="{Binding DuplicateTabBehavior, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:DuplicateTabBehavior.ReuseExisting}, Mode=OneWay}"
                                     Command="{Binding SetDuplicateTabBehaviorCommand}" CommandParameter="{x:Static models:DuplicateTabBehavior.ReuseExisting}" />
                        <RadioButton GroupName="DuplicateTab" Content="自動判定" VerticalAlignment="Center"
                                     IsChecked="{Binding DuplicateTabBehavior, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:DuplicateTabBehavior.Auto}, Mode=OneWay}"
                                     Command="{Binding SetDuplicateTabBehaviorCommand}" CommandParameter="{x:Static models:DuplicateTabBehavior.Auto}" />
                    </StackPanel>
                    <!-- 仕様書17章「PowerShellプロファイル」。新しく開くターミナルタブから反映される。 -->
                    <CheckBox Content="ターミナルでPowerShellプロファイルを読み込む" Margin="0,16,0,0"
                              IsChecked="{Binding LoadTerminalProfile, Mode=TwoWay}" />
                    <!-- 仕様書35章「Windows Explorer連携」。フォルダの右クリックメニューへの登録・解除を
                         即座に行う（HKEY_CURRENT_USERのみ使用するため管理者権限は不要）。 -->
                    <CheckBox Content="フォルダの右クリックメニューに「ExplorerAlternativeで開く」を追加する" Margin="0,12,0,0"
                              IsChecked="{Binding ExplorerIntegrationEnabled, Mode=TwoWay}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Windows連携">
                <StackPanel Margin="12">
                    <TextBlock Text="システムトレイ・グローバルホットキー" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <!-- 仕様書40章。ONの場合、ウィンドウを閉じるとトレイへ格納される（終了はトレイメニューから）。 -->
                    <CheckBox Content="システムトレイに常駐する" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                    <!-- 仕様書41章。他アプリ使用中でもホットキーでウィンドウを呼び出せる。競合時はエラーを表示する。 -->
                    <CheckBox Content="グローバルホットキーを有効にする" Margin="0,12,0,4"
                              IsChecked="{Binding GlobalHotkeyEnabled, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                        <CheckBox Content="Ctrl" Margin="0,0,12,0" IsChecked="{Binding HotkeyCtrl, Mode=TwoWay}" />
                        <CheckBox Content="Alt" Margin="0,0,12,0" IsChecked="{Binding HotkeyAlt, Mode=TwoWay}" />
                        <CheckBox Content="Shift" Margin="0,0,12,0" IsChecked="{Binding HotkeyShift, Mode=TwoWay}" />
                        <CheckBox Content="Win" Margin="0,0,12,0" IsChecked="{Binding HotkeyWin, Mode=TwoWay}" />
                        <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="60" Text="{Binding HotkeyKeyText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="適用" Width="70" Margin="12,0,0,0" Command="{Binding ApplyHotkeyCommand}" />
                    </StackPanel>
                    <TextBlock Text="キー名はWPFのKey列挙体の名前を入力してください（例：E、F12、D1）。"
                               Margin="16,4,0,0" FontSize="11" Opacity="0.7" />
                </StackPanel>
            </TabItem>

            <TabItem Header="拡張子">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="テキストとして扱う拡張子" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Width="120" Text="{Binding NewExtension, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="追加" Width="60" Margin="8,0,0,0" Command="{Binding AddExtensionCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding TextFileExtensions}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button Content="削除" DockPanel.Dock="Right"
                                            Command="{Binding DataContext.RemoveExtensionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="4,0" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <TabItem Header="外部ツール">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="外部ツール" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Button DockPanel.Dock="Top" Content="外部ツールを追加..." HorizontalAlignment="Left" Margin="0,0,0,8"
                            Command="{Binding AddExternalToolCommand}" />
                    <ListBox ItemsSource="{Binding ExternalTools}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button Content="削除" DockPanel.Dock="Right"
                                            Command="{Binding DataContext.RemoveExternalToolCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Margin="4,0" VerticalAlignment="Center">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text=" - " />
                                        <Run Text="{Binding ExecutablePath, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="90" Margin="0,0,8,0" Command="{Binding SaveCommand}" Click="SaveButton_Click" />
            <Button Content="閉じる" Width="90" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
