<Window x:Class="ExplorerAlternative.Views.SftpBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExplorerAlternative.Models"
        Title="SFTP"
        Height="600" Width="820"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        Closed="Window_Closed">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Profile.DisplayName}" FontWeight="Bold" FontSize="15"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="⬆ 上へ" Padding="10,4" Command="{Binding GoUpCommand}" />
            <Button DockPanel.Dock="Left" Content="更新" Padding="10,4" Margin="6,0,0,0" Command="{Binding RefreshCommand}" />
            <TextBox Text="{Binding CurrentPath, Mode=OneWay}" IsReadOnly="True" Padding="6,4" Margin="8,0,0,0"
                     VerticalContentAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
            <ListView ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" BorderThickness="0"
                      MouseDoubleClick="ListView_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名前" Width="360">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:RemoteFileEntry}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,6,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="📄" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                            <Setter Property="Text" Value="📁" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="サイズ" Width="120" DisplayMemberBinding="{Binding SizeBytes}" />
                        <GridViewColumn Header="更新日時" Width="180" DisplayMemberBinding="{Binding LastModifiedUtc}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="アップロード..." Padding="10,5" Margin="0,0,8,0" Command="{Binding UploadCommand}" />
            <Button Content="ダウンロード..." Padding="10,5" Margin="0,0,8,0" Command="{Binding DownloadCommand}" />
            <Button Content="新しいフォルダ" Padding="10,5" Margin="0,0,8,0" Command="{Binding NewFolderCommand}" />
            <Button Content="名前の変更" Padding="10,5" Margin="0,0,8,0" Command="{Binding RenameCommand}" />
            <Button Content="削除" Padding="10,5" Margin="0,0,16,0" Command="{Binding DeleteCommand}" />
            <Button Content="閉じる" Padding="10,5" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
