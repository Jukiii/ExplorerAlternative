<Window x:Class="ExplorerAlternative.Views.GitLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExplorerAlternative.Models"
        Title="Log"
        Height="640" Width="960"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 仕様書21章「Log」：コミット履歴を新しい順に一覧表示する。 -->
            <ListBox Grid.Column="0" ItemsSource="{Binding Commits}" SelectedItem="{Binding SelectedCommit}"
                     BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CommitLogEntry}">
                        <StackPanel Margin="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Revision}" FontFamily="Consolas" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding Date}" Margin="10,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Author}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush2}" Focusable="False" />

            <!-- 仕様書21章「Show Commit」：選択したコミットの変更内容をdiff形式でそのまま表示する。 -->
            <TextBox Grid.Column="2" Text="{Binding DiffText, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="{DynamicResource TerminalBackgroundBrush}"
                     Foreground="{DynamicResource TerminalForegroundBrush}"
                     BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}"
                     Margin="8,0,0,0" Padding="8" />
        </Grid>
    </Grid>
</Window>
