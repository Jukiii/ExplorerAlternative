<Window x:Class="ExplorerAlternative.Views.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExplorerAlternative.Models"
        Title="検索"
        Height="480" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}">
            <Run Text="検索対象: " /><Run Text="{Binding RootPath, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="検索" Width="90" Margin="8,0,0,0" IsDefault="True" Command="{Binding SearchCommand}" />
            <Button DockPanel.Dock="Right" Content="キャンセル" Width="90" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
            <TextBox x:Name="QueryTextBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                     VerticalContentAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="2" Margin="0,0,0,8" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding StatusMessage}" />

        <ListView Grid.Row="3" ItemsSource="{Binding Results}"
                  BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                  MouseDoubleClick="ResultsListView_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                            <Setter Property="Padding" Value="6,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>
                    <GridViewColumn Header="名前" Width="220">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FileSystemEntry}">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="場所" Width="320" DisplayMemberBinding="{Binding FullPath}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
