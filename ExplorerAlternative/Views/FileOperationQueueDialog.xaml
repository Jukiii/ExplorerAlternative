<Window x:Class="ExplorerAlternative.Views.FileOperationQueueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExplorerAlternative.Models"
        Title="ファイル操作キュー"
        Height="420" Width="560"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" ItemsSource="{Binding Items}" BorderThickness="1"
                 BorderBrush="{DynamicResource BorderBrush2}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:FileOperationQueueItem}">
                    <Border Margin="0,3" Padding="8" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource BorderBrush2}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="一時停止" Padding="6,2" Margin="4,0,0,0"
                                            Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="再開" Padding="6,2" Margin="4,0,0,0"
                                            Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="キャンセル" Padding="6,2" Margin="4,0,0,0"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="{Binding Kind, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text=" - " />
                                    <Run Text="{Binding Summary, Mode=OneWay}" />
                                    <Run Text=" → " />
                                    <Run Text="{Binding DestinationFolder, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </TextBlock>
                            </DockPanel>
                            <ProgressBar Height="6" Margin="0,6,0,2" Minimum="0" Maximum="100"
                                         Value="{Binding ProgressPercent, Mode=OneWay}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{Binding StatusDisplay, Mode=OneWay}" />
                                <Run Text=" - " />
                                <Run Text="{Binding ProcessedCount, Mode=OneWay}" />
                                <Run Text="/" />
                                <Run Text="{Binding TotalCount, Mode=OneWay}" />
                                <Run Text=" - " />
                                <Run Text="{Binding CurrentFileName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="閉じる" Width="90" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
