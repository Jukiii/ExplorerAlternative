<Window x:Class="ExplorerAlternative.Views.SshProfilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExplorerAlternative.Models"
        Title="SSH接続の管理"
        Height="420" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                 BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                 MouseDoubleClick="ProfilesListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:SshConnectionProfile}">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{Binding UserName, Mode=OneWay}" /><Run Text="@" /><Run Text="{Binding Host, Mode=OneWay}" /><Run Text=":" /><Run Text="{Binding Port, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="パスワード・パスフレーズは保存されません。接続はOpenSSH（統合ターミナル）へ委譲します。" />

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="追加..." Width="80" Margin="0,0,6,0" Command="{Binding AddCommand}" />
                <Button Content="編集..." Width="80" Margin="0,0,6,0" Command="{Binding EditCommand}" />
                <Button Content="削除" Width="80" Command="{Binding DeleteCommand}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="接続" Width="90" Margin="0,0,8,0" IsDefault="True" Command="{Binding ConnectCommand}" />
                <Button Content="閉じる" Width="90" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
