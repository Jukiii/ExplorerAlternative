<Window x:Class="ExplorerAlternative.Views.BulkRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExplorerAlternative.ViewModels"
        Title="一括名前変更"
        Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="新しい名前のパターンを入力してください。" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                   Text="{}{n} = 連番（1から）　{name} = 元の名前（拡張子を除く）　{ext} = 拡張子"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10" />

        <TextBox Grid.Row="2" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                 Padding="6,4" Margin="0,0,0,10" />

        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
            <ListView ItemsSource="{Binding PreviewItems}" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="現在の名前" Width="220" DisplayMemberBinding="{Binding OriginalName}" />
                        <GridViewColumn Header="変更後の名前" Width="220" DisplayMemberBinding="{Binding NewName}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="適用" Width="90" Margin="0,0,8,0" IsDefault="True" Click="ApplyButton_Click" />
            <Button Content="キャンセル" Width="90" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
