<Window x:Class="ExplorerAlternative.Views.TagEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExplorerAlternative.ViewModels"
        Title="タグ"
        Height="360" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="タグ名" Margin="0,0,0,4" />
        <TextBox Grid.Row="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,14" />

        <TextBlock Grid.Row="2" Text="アイコン" Margin="0,0,0,4" />
        <ListBox Grid.Row="3" ItemsSource="{x:Static vm:TagEditorViewModel.IconChoices}"
                 SelectedItem="{Binding IconGlyph, Mode=TwoWay}"
                 BorderThickness="0" Background="Transparent" Margin="0,0,0,14">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="20" Margin="4" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="4" Text="色（任意）" Margin="0,0,0,4" />
        <StackPanel Grid.Row="5" Orientation="Vertical" VerticalAlignment="Top">
            <ListBox ItemsSource="{x:Static vm:TagEditorViewModel.ColorChoices}"
                     SelectedItem="{Binding ColorHex, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="22" Height="22" Margin="4" CornerRadius="11"
                                Background="{Binding Converter={StaticResource HexColorToBrushConverter}}"
                                BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="色なしにする" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="6,2"
                    Click="ClearColorButton_Click" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="90" Margin="0,0,8,0" IsDefault="True" Click="SaveButton_Click" />
            <Button Content="キャンセル" Width="90" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
