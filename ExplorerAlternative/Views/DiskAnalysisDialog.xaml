<Window x:Class="ExplorerAlternative.Views.DiskAnalysisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExplorerAlternative.ViewModels"
        xmlns:models="clr-namespace:ExplorerAlternative.Models"
        Title="ディスク解析"
        Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton GroupName="Mode" Content="巨大ファイル検索" Margin="0,0,16,0" VerticalAlignment="Center"
                         IsChecked="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:DiskAnalysisMode.LargeFiles}, Mode=OneWay}"
                         Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:DiskAnalysisMode.LargeFiles}" />
            <RadioButton GroupName="Mode" Content="重複ファイル検索" Margin="0,0,16,0" VerticalAlignment="Center"
                         IsChecked="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:DiskAnalysisMode.Duplicates}, Mode=OneWay}"
                         Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:DiskAnalysisMode.Duplicates}" />
            <RadioButton GroupName="Mode" Content="空フォルダ検索" VerticalAlignment="Center"
                         IsChecked="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:DiskAnalysisMode.EmptyFolders}, Mode=OneWay}"
                         Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:DiskAnalysisMode.EmptyFolders}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="対象フォルダ" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right" Content="参照..." Width="70" Click="BrowseButton_Click" />
            <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,8,0"
                     VerticalContentAlignment="Center" />
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="最小サイズ (MB)" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:DiskAnalysisMode.LargeFiles}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBox Text="{Binding MinSizeMb, UpdateSourceTrigger=PropertyChanged}" Width="100" Padding="6,4"
                     HorizontalAlignment="Left">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:DiskAnalysisMode.LargeFiles}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="キャンセル" Width="90" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
            <Button DockPanel.Dock="Right" Content="検索" Width="90" Margin="8,0,0,0" Command="{Binding RunCommand}" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
        </DockPanel>

        <!-- 巨大ファイル検索の結果 -->
        <ListView Grid.Row="4" ItemsSource="{Binding LargeFiles}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
            <ListView.Style>
                <Style TargetType="ListView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:DiskAnalysisMode.LargeFiles}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Style>
            <ListView.View>
                <GridView>
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                            <Setter Property="Padding" Value="6,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>
                    <GridViewColumn Header="サイズ" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:LargeFileResult}">
                                <TextBlock Text="{Binding SizeBytes, Converter={StaticResource ByteSizeConverter}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="パス" Width="500" DisplayMemberBinding="{Binding FullPath}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 重複ファイル検索の結果 -->
        <ListView Grid.Row="4" ItemsSource="{Binding DuplicateFiles}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
            <ListView.Style>
                <Style TargetType="ListView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:DiskAnalysisMode.Duplicates}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Style>
            <ListView.View>
                <GridView>
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                            <Setter Property="Padding" Value="6,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>
                    <GridViewColumn Header="削除">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:DuplicateFileRowViewModel}">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="サイズ" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:DuplicateFileRowViewModel}">
                                <TextBlock Text="{Binding SizeBytes, Converter={StaticResource ByteSizeConverter}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="パス" Width="440" DisplayMemberBinding="{Binding FullPath}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 空フォルダ検索の結果 -->
        <ListView Grid.Row="4" ItemsSource="{Binding EmptyFolders}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
            <ListView.Style>
                <Style TargetType="ListView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:DiskAnalysisMode.EmptyFolders}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Style>
            <ListView.View>
                <GridView>
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                            <Setter Property="Padding" Value="6,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>
                    <GridViewColumn Header="削除">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:EmptyFolderRowViewModel}">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="パス" Width="530" DisplayMemberBinding="{Binding FullPath}" />
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="選択項目を削除..." Width="140" Command="{Binding DeleteSelectedCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:DiskAnalysisMode.LargeFiles}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button DockPanel.Dock="Right" Content="閉じる" Width="90" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
