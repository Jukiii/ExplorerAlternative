<Window x:Class="ExplorerAlternative.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExplorerAlternative.ViewModels"
        xmlns:conv="clr-namespace:ExplorerAlternative.Converters"
        Title="プレビュー"
        Height="520" Width="700"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <conv:DepthToIndentConverter x:Key="DepthToIndentConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 仕様書13章・15章：タイトルと、固定・前後移動・Markdown表示切替のツールバー。 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ToggleButton Content="📌" Width="28" Margin="4,0,0,0" ToolTip="固定（別項目選択時も維持）"
                              IsChecked="{Binding IsPinned, Mode=TwoWay}" />
                <Button Content="◀" Width="28" Margin="4,0,0,0" ToolTip="前へ (←)" Command="{Binding PreviousCommand}" />
                <Button Content="▶" Width="28" Margin="4,0,0,0" ToolTip="次へ (→)" Command="{Binding NextCommand}" />
                <Button Width="110" Margin="4,0,0,0" Command="{Binding ToggleMarkdownSourceCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="ソース表示" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PreviewKind.Markdown}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsShowingMarkdownSource}" Value="True">
                                    <Setter Property="Content" Value="レンダリング表示" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="1">
            <!-- 注意: Visibilityをここでローカル値として指定すると、Style内のDataTriggerより
                 優先されてしまい常にCollapsedのままになる（プレビューが表示されない不具合の原因だった）。
                 既定値は必ずStyle内のSetterとして指定すること。 -->
            <DockPanel>
                <!-- 仕様書16章「コードシンボル表示」：対応言語のソースコードのみ、左側にシンボル一覧を表示する。
                     選択するとRequestJumpToLine経由で該当行へジャンプする（コードビハインド参照）。 -->
                <ListBox x:Name="SymbolsListBox" DockPanel.Dock="Left" Width="180" Margin="0,0,8,0"
                         ItemsSource="{Binding Symbols}"
                         SelectedItem="{Binding SelectedSymbol, Mode=TwoWay}"
                         BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSymbols}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"
                                       Margin="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}"
                                       ToolTip="{Binding DisplayText}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBox x:Name="TextViewer"
                         Text="{Binding TextContent, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         Background="{DynamicResource WindowBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderThickness="0">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PreviewKind.Text}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PreviewKind.Unsupported}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <!-- 仕様書13章：Markdownの「ソース表示」時はこちらを表示する。 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Kind}" Value="{x:Static vm:PreviewKind.Markdown}" />
                                        <Condition Binding="{Binding IsShowingMarkdownSource}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </DockPanel>

            <RichTextBox x:Name="MarkdownViewer"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource WindowBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderThickness="0">
                <RichTextBox.Style>
                    <Style TargetType="RichTextBox">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Kind}" Value="{x:Static vm:PreviewKind.Markdown}" />
                                    <Condition Binding="{Binding IsShowingMarkdownSource}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </RichTextBox.Style>
            </RichTextBox>

            <!-- 仕様書13章：画像プレビュー。マウスホイールで拡大縮小、スクロールバーでパンする。 -->
            <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="ImageScrollViewer_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="ImageScrollViewer_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="ImageScrollViewer_PreviewMouseLeftButtonUp"
                          Cursor="SizeAll">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PreviewKind.Image}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Image x:Name="PreviewImage" Source="{Binding ImageSource}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.LayoutTransform>
                        <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1" />
                    </Image.LayoutTransform>
                </Image>
            </ScrollViewer>

            <!-- 仕様書13章「PDF」：フルレンダリングは行わず、ファイル情報＋既定アプリで開くボタンのみ表示する。 -->
            <StackPanel VerticalAlignment="Top">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PreviewKind.Pdf}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding TextContent}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Button Content="既定のアプリで開く" HorizontalAlignment="Left" Padding="10,6" Command="{Binding OpenExternallyCommand}" />
            </StackPanel>

            <!-- 仕様書14章：フォルダQuick Look（項目数・サイズ・更新日時・Git/SVN状態・タグ・最近変更されたファイル）。 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PreviewKind.Folder}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <TextBlock Text="{Binding FolderSummary}" FontSize="14" Margin="0,0,0,6" />
                    <TextBlock Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FolderSizeDisplay}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="サイズ（合計）: " FontWeight="Bold" /><Run Text="{Binding FolderSizeDisplay, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FolderModified}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="更新日時: " FontWeight="Bold" /><Run Text="{Binding FolderModified, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FolderVcsSummary}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="バージョン管理: " FontWeight="Bold" /><Run Text="{Binding FolderVcsSummary, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FolderTagsSummary}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="タグ: " FontWeight="Bold" /><Run Text="{Binding FolderTagsSummary, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="最近変更されたファイル" FontWeight="Bold" Margin="0,10,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentFiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding RecentFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="※ ファイルサイズが大きいため、先頭部分のみ表示しています。"
                   Foreground="Gray"
                   Margin="0,8,0,0"
                   Visibility="{Binding Truncated, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</Window>
