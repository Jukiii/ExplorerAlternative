<Window x:Class="ExplorerAlternative.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExplorerAlternative.ViewModels"
        Title="プレビュー"
        Height="480" Width="640"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />

        <Grid Grid.Row="1">
            <TextBox x:Name="TextViewer"
                     Text="{Binding TextContent, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     Visibility="Collapsed">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PreviewKind.Text}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PreviewKind.Unsupported}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <RichTextBox x:Name="MarkdownViewer"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         Visibility="Collapsed">
                <RichTextBox.Style>
                    <Style TargetType="RichTextBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PreviewKind.Markdown}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RichTextBox.Style>
            </RichTextBox>

            <TextBlock x:Name="FolderViewer"
                       Text="{Binding FolderSummary}"
                       Visibility="Collapsed">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PreviewKind.Folder}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="※ ファイルサイズが大きいため、先頭部分のみ表示しています。"
                   Foreground="Gray"
                   Margin="0,8,0,0"
                   Visibility="{Binding Truncated, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</Window>
