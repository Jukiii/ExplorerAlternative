<Window x:Class="ExplorerAlternative.Views.FileOperationHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ファイル操作履歴"
        Height="480" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="すべて削除" Command="{Binding ClearCommand}" Margin="8,0,0,0" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="4" />
        </DockPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding Entries}" BorderThickness="1"
                  BorderBrush="{DynamicResource BorderBrush2}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="時刻" Width="130" DisplayMemberBinding="{Binding Timestamp, StringFormat='yyyy/MM/dd HH:mm:ss'}" />
                    <GridViewColumn Header="操作" Width="90" DisplayMemberBinding="{Binding Operation}" />
                    <GridViewColumn Header="対象" Width="150" DisplayMemberBinding="{Binding Target}" />
                    <GridViewColumn Header="元の場所" Width="130" DisplayMemberBinding="{Binding OriginalLocation}" />
                    <GridViewColumn Header="移動先" Width="130" DisplayMemberBinding="{Binding Destination}" />
                    <GridViewColumn Header="成否" Width="50" DisplayMemberBinding="{Binding SuccessDisplay}" />
                    <GridViewColumn Header="" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" FontSize="9" Width="20" Height="20" Padding="0"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="閉じる" Width="90" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
