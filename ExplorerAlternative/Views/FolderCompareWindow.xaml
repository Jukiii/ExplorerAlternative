<Window x:Class="ExplorerAlternative.Views.FolderCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="フォルダ比較・同期"
        Height="640" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="左:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding LeftFolder, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
            <Button Grid.Column="2" Content="参照..." Padding="10,4" Margin="8,0,0,0" Click="BrowseLeftButton_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="右:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding RightFolder, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
            <Button Grid.Column="2" Content="参照..." Padding="10,4" Margin="8,0,0,0" Click="BrowseRightButton_Click" />
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="比較" Padding="14,5" Command="{Binding CompareCommand}" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </DockPanel>

        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
            <ListView ItemsSource="{Binding Entries}" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="32">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="相対パス" Width="380" DisplayMemberBinding="{Binding RelativePath}" />
                        <GridViewColumn Header="状態" Width="120" DisplayMemberBinding="{Binding StatusDisplay}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="すべて選択" Padding="10,5" Margin="0,0,8,0" Command="{Binding SelectAllCommand}" />
            <Button Content="選択解除" Padding="10,5" Margin="0,0,16,0" Command="{Binding SelectNoneCommand}" />
            <Button Content="選択項目を 左 → 右 にコピー" Padding="10,5" Margin="0,0,8,0" Command="{Binding CopyToRightCommand}" />
            <Button Content="選択項目を 右 → 左 にコピー" Padding="10,5" Margin="0,0,16,0" Command="{Binding CopyToLeftCommand}" />
            <Button Content="閉じる" Padding="10,5" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
