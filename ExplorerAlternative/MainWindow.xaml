<Window x:Class="ExplorerAlternative.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExplorerAlternative.ViewModels"
        xmlns:models="clr-namespace:ExplorerAlternative.Models"
        xmlns:conv="clr-namespace:ExplorerAlternative.Converters"
        Title="Explorer Alternative"
        Height="760" Width="1280"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:DepthToIndentConverter x:Key="DepthToIndentConverter" />
        <ContextMenu x:Key="NodeContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="開く" Command="{Binding OpenCommand}" />
            <!-- 仕様書10章・37章：フォルダのみ有効（CanExecuteでIsDirectoryを判定）。 -->
            <MenuItem Header="新しいタブで開く" Command="{Binding OpenInNewTabCommand}" />
            <!-- 仕様書34章：アプリで開く（ファイルのみ有効）。 -->
            <MenuItem Header="アプリで開く">
                <MenuItem Header="既定のアプリで開く" Command="{Binding OpenWithDefaultAppCommand}" />
                <MenuItem Header="アプリを選択..." Command="{Binding OpenWithBrowseCommand}" />
            </MenuItem>
            <!-- 仕様書35章：Windows Explorerとの連携。 -->
            <MenuItem Header="Windows Explorerで開く" Command="{Binding OpenInWindowsExplorerCommand}" />
            <!-- 仕様書19章：ターミナル連携。 -->
            <MenuItem Header="ここでPowerShellを開く" Command="{Binding OpenPowerShellHereCommand}" />
            <MenuItem Header="ここでターミナルを開く" Command="{Binding OpenTerminalHereCommand}" />
            <MenuItem Header="新しいフォルダ" Command="{Binding NewFolderCommand}" />
            <MenuItem Header="新しいファイル" Command="{Binding NewFileCommand}" />
            <Separator />
            <MenuItem Header="コピー" Command="{Binding CopyCommand}" />
            <MenuItem Header="移動 (切り取り)" Command="{Binding CutCommand}" />
            <MenuItem Header="貼り付け" Command="{Binding PasteCommand}" />
            <Separator />
            <MenuItem Header="名前の変更" Command="{Binding RenameCommand}" />
            <MenuItem Header="一括名前変更..." Command="{Binding BulkRenameCommand}" />
            <MenuItem Header="削除" Command="{Binding DeleteCommand}" />
            <Separator />
            <!-- 仕様書28章：パスコピー。 -->
            <MenuItem Header="パスをコピー">
                <MenuItem Header="フルパスをコピー" Command="{Binding CopyPathCommand}" CommandParameter="FullPath" />
                <MenuItem Header="ファイル名をコピー" Command="{Binding CopyPathCommand}" CommandParameter="FileName" />
                <MenuItem Header="フォルダパスをコピー" Command="{Binding CopyPathCommand}" CommandParameter="FolderPath" />
                <MenuItem Header="相対パスをコピー" Command="{Binding CopyPathCommand}" CommandParameter="RelativePath" />
                <MenuItem Header="URIをコピー" Command="{Binding CopyPathCommand}" CommandParameter="Uri" />
            </MenuItem>
            <MenuItem Header="プロパティ" Command="{Binding ShowPropertiesCommand}" />
            <Separator />
            <!-- 仕様書25章：任意の2ファイル比較（Git管理外でも利用可能）。 -->
            <MenuItem Header="比較対象として保持" Command="{Binding HoldForComparisonCommand}" />
            <MenuItem Header="比較対象と比較" Command="{Binding CompareWithHeldCommand}" />
            <Separator />
            <!-- 仕様書6.2章：ファイル・フォルダへのタグ付与。チェック状態は選択の代表ノード
                 （PrimarySelectedNode）が持つタグから判定する。 -->
            <MenuItem Header="タグ" ItemsSource="{Binding AvailableTags}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="IsCheckable" Value="True" />
                        <Setter Property="Command"
                                Value="{Binding DataContext.ToggleTagCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                        <Setter Property="IsChecked">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource TagAssignedConverter}" Mode="OneWay">
                                    <Binding Path="." />
                                    <Binding Path="DataContext.PrimarySelectedNode.Tags"
                                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator />
            <MenuItem Header="外部ツール" ItemsSource="{Binding ExternalTools}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="Command"
                                Value="{Binding DataContext.RunExternalToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator />
            <!-- 仕様書56章：それぞれ検出されている場合のみ有効になる。 -->
            <MenuItem Header="ルートへ移動">
                <MenuItem Header="プロジェクトルートへ移動" Command="{Binding GoToProjectRootCommand}" />
                <MenuItem Header="ソリューションルートへ移動" Command="{Binding GoToSolutionRootCommand}" />
                <MenuItem Header="Gitルートへ移動" Command="{Binding GoToGitRootCommand}" />
            </MenuItem>
            <Separator />
            <!-- 仕様書14章：Git/SVN管理下のフォルダでのみ有効になる（CanExecuteでVcsInfo.Kindを判定）。 -->
            <MenuItem Header="Patchを作成..." Command="{Binding CreatePatchCommand}" />
            <MenuItem Header="Patchを適用..." Command="{Binding ApplyPatchCommand}" />
            <Separator />
            <!-- 仕様書13章・20章・21章・22章：Git/SVN操作。Git専用の項目はGitのときのみ有効になる。 -->
            <MenuItem Header="Git/SVN操作">
                <MenuItem Header="Show Diff" Command="{Binding ShowDiffCommand}" />
                <MenuItem Header="変更を破棄 (Discard/Revert)" Command="{Binding DiscardChangesCommand}" />
                <Separator />
                <MenuItem Header="変更をステージ" Command="{Binding StageAllCommand}" />
                <MenuItem Header="コミット..." Command="{Binding CommitCommand}" />
                <Separator />
                <MenuItem Header="プッシュ" Command="{Binding PushCommand}" />
                <MenuItem Header="プル" Command="{Binding PullCommand}" />
                <MenuItem Header="Fetch" Command="{Binding FetchCommand}" />
                <Separator />
                <MenuItem Header="ブランチを切り替え..." Command="{Binding ShowBranchesCommand}" />
                <MenuItem Header="新規ブランチ作成..." Command="{Binding CreateBranchCommand}" />
                <MenuItem Header="Merge..." Command="{Binding MergeCommand}" />
                <MenuItem Header="Rebase..." Command="{Binding RebaseCommand}" />
                <Separator />
                <MenuItem Header="Stash" Command="{Binding StashCommand}" />
                <MenuItem Header="Stash Pop" Command="{Binding StashPopCommand}" />
                <Separator />
                <MenuItem Header="更新 (svn update)" Command="{Binding UpdateCommand}" />
                <Separator />
                <MenuItem Header="Initialize (git init)" Command="{Binding InitRepositoryCommand}" />
                <MenuItem Header="Clone..." Command="{Binding CloneRepositoryCommand}" />
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Window.InputBindings>
        <!-- Window.InputBindings は論理ツリーに属さずDataContextを継承しないため、
             ElementName経由でWindowのDataContextを明示的に参照する必要がある。
             SpaceキーとCtrl+@（ターミナル表示切替）は、ListBoxやTextBox等の個別コントロールが
             内部消費してWindow.InputBindingsまでバブリングしないことがあるため、
             コードビハインドのPreviewKeyDownでトンネリング段階で処理する（MainWindow.xaml.cs参照）。
             仕様書9.1章「Ctrl + @」：JISキーボードでは「@」＝OemTilde（無変換）だが、USキーボード
             配列では「@」はShift+2で入力するため、両方をCtrl+@として扱う（PreviewKeyDown側で判定）。 -->
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding DataContext.GoUpCommand, ElementName=RootWindow}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding DataContext.GoBackCommand, ElementName=RootWindow}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding DataContext.GoForwardCommand, ElementName=RootWindow}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding DataContext.ActiveTab.ActivePane.BeginAddressEditCommand, ElementName=RootWindow}" />
        <!-- 仕様書12章：Ctrl+Fで検索。 -->
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding DataContext.OpenSearchCommand, ElementName=RootWindow}" />
        <!-- 仕様書36章「Ctrl+Dでブックマーク（お気に入り）に追加」。 -->
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DataContext.AddFavoriteCommand, ElementName=RootWindow}" />
        <!-- 仕様書46章：コマンドパレット。 -->
        <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding DataContext.OpenCommandPaletteCommand, ElementName=RootWindow}" />
        <KeyBinding Key="F5" Command="{Binding DataContext.ActiveTab.ActivePane.RefreshCommand, ElementName=RootWindow}" />
        <KeyBinding Key="F6" Command="{Binding DataContext.ActiveTab.ActivePane.BeginAddressEditCommand, ElementName=RootWindow}" />
        <!-- 仕様書10章：タブ操作のショートカット。 -->
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding DataContext.AddTabCommand, ElementName=RootWindow}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding DataContext.CloseTabCommand, ElementName=RootWindow}"
                    CommandParameter="{Binding DataContext.ActiveTab, ElementName=RootWindow}" />
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding DataContext.NextTabCommand, ElementName=RootWindow}" />
        <!-- 仕様書20章：Ctrl+Nで新しいフォルダを作成。 -->
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding DataContext.ActiveTab.ActivePane.NewFolderCommand, ElementName=RootWindow}" />
        <!-- Ctrl+,で設定を開く（多くのWindows/Macアプリで一般的なショートカット）。 -->
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding DataContext.OpenSettingsCommand, ElementName=RootWindow}" />
    </Window.InputBindings>

    <!-- IsSharedSizeScope: ターミナル行（下記Grid.Row="3"）の列幅を、ナビゲーション/メイン/
         Git・SVNペインの行（Grid.Row="2"）の列幅と自動的に同期させるため。 -->
    <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タブ行 -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Menu DockPanel.Dock="Right" Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="☰ メニュー" Padding="8,6">
                        <MenuItem Header="お気に入りに追加" Command="{Binding AddFavoriteCommand}" />
                        <Separator />
                        <MenuItem Header="右に分割" Command="{Binding SplitHorizontalCommand}" />
                        <MenuItem Header="下に分割" Command="{Binding SplitVerticalCommand}" />
                        <MenuItem Header="ペインを閉じる" Command="{Binding ClosePaneCommand}" />
                        <MenuItem Header="ペインを入れ替え" Command="{Binding ActiveTab.SwapPanesCommand}" />
                        <MenuItem Header="Git/SVN情報ペインを表示/非表示" Command="{Binding ToggleVcsPaneCommand}" />
                        <Separator />
                        <MenuItem Header="検索... (Ctrl+F)" Command="{Binding OpenSearchCommand}" />
                        <MenuItem Header="ディスク解析..." Command="{Binding OpenDiskAnalysisCommand}" />
                        <MenuItem Header="コマンドパレット... (Ctrl+Shift+P)" Command="{Binding OpenCommandPaletteCommand}" />
                        <Separator />
                        <MenuItem Header="ワークスペースを保存"
                                  Command="{Binding SaveWorkspaceCommand}"
                                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                        <MenuItem Header="ワークスペースを開く"
                                  Command="{Binding LoadWorkspaceCommand}"
                                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Separator />
                        <MenuItem Header="SSH接続の管理..." Command="{Binding OpenSshConnectionCommand}" />
                        <Separator />
                        <MenuItem Header="設定..." Command="{Binding OpenSettingsCommand}" />
                        <MenuItem Header="ショートカット一覧" Command="{Binding OpenCheatSheetCommand}" />
                    </MenuItem>
                </Menu>
                <!-- 新しいタブボタンはタブのすぐ右側に配置する（DockPanelの残り全幅を専有させず、
                     タブと同じStackPanelでコンテンツ幅に収める）。 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource TabItemContainerStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TabViewModel}">
                                <DockPanel Margin="10,6" MinWidth="110" ToolTip="Ctrl+ドラッグで複製 / 右クリックで固定"
                                           PreviewMouseLeftButtonDown="TabItem_PreviewMouseLeftButtonDown"
                                           PreviewMouseMove="TabItem_PreviewMouseMove"
                                           PreviewMouseLeftButtonUp="TabItem_PreviewMouseLeftButtonUp">
                                    <DockPanel.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{Binding PinMenuHeader}" Command="{Binding TogglePinCommand}" />
                                            <MenuItem Header="閉じる"
                                                      Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                    <!-- 仕様書10章「タブ固定」：固定中は閉じるボタンの代わりにピンアイコンを表示する。 -->
                                    <Button DockPanel.Dock="Right" Content="✕" FontSize="10" Width="20" Height="20" Padding="0"
                                            Margin="8,0,0,0" ToolTip="タブを閉じる"
                                            Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock DockPanel.Dock="Right" Text="📌" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                                               ToolTip="固定されています"
                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="📁" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="13" />
                                    <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="＋" FontSize="15" Width="34" Margin="4" Padding="0"
                            ToolTip="新しいタブ" Command="{Binding AddTabCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ナビゲーション / ツールバー -->
        <Border Grid.Row="1" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,6" LastChildFill="True"
                       DataContext="{Binding ActiveTab.ActivePane}">
                <Button DockPanel.Dock="Left" Content="←" FontSize="14" Width="30" Padding="0" ToolTip="戻る (Alt+←)"
                        Command="{Binding GoBackCommand}" />
                <Button DockPanel.Dock="Left" Content="→" FontSize="14" Width="30" Padding="0" Margin="2,0,0,0" ToolTip="進む (Alt+→)"
                        Command="{Binding GoForwardCommand}" />
                <Button DockPanel.Dock="Left" Content="⬆" FontSize="14" Width="30" Padding="0" Margin="6,0,0,0" ToolTip="親フォルダへ移動 (Alt+↑)"
                        Command="{Binding GoUpCommand}" />

                <Border DockPanel.Dock="Right" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="5"
                        Margin="10,0,0,0" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="詳細" Padding="10,4"
                                      IsChecked="{Binding CurrentViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ViewMode.Detail}, Mode=OneWay}"
                                      Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ViewMode.Detail}" />
                        <ToggleButton Content="階層" Padding="10,4" Margin="2,0,0,0"
                                      IsChecked="{Binding CurrentViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ViewMode.Tree}, Mode=OneWay}"
                                      Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ViewMode.Tree}" />
                    </StackPanel>
                </Border>

                <!-- 仕様書49章：隠しファイルの表示/非表示切替。 -->
                <ToggleButton DockPanel.Dock="Right" Content="隠しファイル" Padding="10,4" Margin="6,0,0,0"
                              ToolTip="隠しファイル（. で始まる名前 / Hidden・System属性）の表示切替"
                              IsChecked="{Binding ShowHiddenFiles, Mode=OneWay}"
                              Command="{Binding ToggleShowHiddenFilesCommand}" />

                <!-- 仕様書11章：アドレスバーは残りの横幅いっぱいに伸ばす（DockPanelの最後の子要素にして埋める）。 -->
                <Grid Margin="10,0,0,0">
                <!-- 仕様書11章：パンくず部分の空白（segment/dropdownボタン以外）をクリックしたら
                     アドレス編集モードへ切り替える（Windows 11 Explorerと同様の操作感）。 -->
                <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="5" Padding="6,0"
                        PreviewMouseLeftButtonDown="AddressBarBorder_PreviewMouseLeftButtonDown">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAddressEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding BreadcrumbSegments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BreadcrumbSegmentViewModel}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding DisplayName}" Command="{Binding NavigateCommand}"
                                                    Padding="6,4" />
                                            <ToggleButton Content="⌄" Width="18" Padding="0"
                                                          IsChecked="{Binding IsDropdownOpen, Mode=TwoWay}" />
                                            <Popup IsOpen="{Binding IsDropdownOpen, Mode=TwoWay}" StaysOpen="False" Placement="Bottom">
                                                <Border Background="{DynamicResource WindowBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                                        CornerRadius="4" Padding="2">
                                                    <ListBox ItemsSource="{Binding DropdownItems}" MaxHeight="240" MinWidth="160"
                                                             BorderThickness="0">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:BreadcrumbDropdownItem}">
                                                                <!-- 仕様書11章：左クリック＝パス全体を置換、右クリック＝下層を維持したまま部分置換。 -->
                                                                <Button Content="{Binding Name}" Command="{Binding NavigateCommand}"
                                                                        ToolTip="左クリック: このフォルダへ移動 / 右クリック: 現在の下層パスを維持したまま置換"
                                                                        HorizontalContentAlignment="Left"
                                                                        HorizontalAlignment="Stretch"
                                                                        PreviewMouseRightButtonUp="BreadcrumbDropdownItem_PreviewMouseRightButtonUp" />
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Border>
                                            </Popup>
                                            <TextBlock Text="/" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="✎" Width="24" Padding="0" ToolTip="パスを編集" Foreground="{DynamicResource TextSecondaryBrush}"
                                    Command="{Binding BeginAddressEditCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBox x:Name="AddressEditTextBox" Text="{Binding AddressEditText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="6,4"
                         Background="{DynamicResource WindowBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource AccentBrush}"
                         IsVisibleChanged="AddressEditTextBox_IsVisibleChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAddressEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding DataContext.ActiveTab.ActivePane.CommitAddressEditCommand, ElementName=RootWindow}" />
                        <KeyBinding Key="Escape" Command="{Binding DataContext.ActiveTab.ActivePane.CancelAddressEditCommand, ElementName=RootWindow}" />
                    </TextBox.InputBindings>
                </TextBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ナビゲーションペイン + メインペイン + Git/SVN情報ペイン -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="NavPaneColumn" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="NavSplitterColumn" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="VcsSplitterColumn" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="VcsPaneColumn" />
            </Grid.ColumnDefinitions>

            <!-- ナビゲーションペイン（仕様書4章・6章） -->
            <Border Grid.Column="0" Width="230" Background="{DynamicResource PanelBackgroundBrush}"
                    Visibility="{Binding NavigationPane.IsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <DockPanel Margin="10">
                    <Button DockPanel.Dock="Top" Content="« 折りたたむ" HorizontalAlignment="Left"
                            Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                            Command="{Binding NavigationPane.ToggleCollapsedCommand}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- ドライブ（仕様書4章） -->
                            <TextBlock Text="ドライブ" FontWeight="SemiBold" Margin="2,14,0,4" />
                            <ListBox ItemsSource="{Binding NavigationPane.Drives}"
                                     BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                                     PreviewMouseWheel="NavListBox_PreviewMouseWheel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:FavoriteEntry}">
                                        <Button Content="{Binding Name}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.NavigationPane.NavigateToEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="💽" Margin="0,0,6,0" FontSize="11" />
                                                        <TextBlock Text="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- お気に入り（仕様書4章・36章）：クイックアクセス相当の標準フォルダも統合した単一の一覧。
                                 削除・名前変更・▲▼ボタンでの並び替えに加え、フォルダのドラッグ&ドロップ追加、
                                 お気に入り欄内でのドラッグ&ドロップによる並び替えに対応。 -->
                            <TextBlock Text="お気に入り" FontWeight="SemiBold" Margin="2,14,0,4" />
                            <ListBox ItemsSource="{Binding NavigationPane.Favorites}" MaxHeight="200"
                                     BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                                     PreviewMouseWheel="NavListBox_PreviewMouseWheel"
                                     PreviewMouseLeftButtonDown="FavoritesListBox_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="FavoritesListBox_PreviewMouseMove"
                                     AllowDrop="True"
                                     DragOver="FavoritesListBox_DragOver"
                                     Drop="FavoritesListBox_Drop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:FavoriteEntry}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="▲" FontSize="8" Width="18" Height="20" Padding="0" ToolTip="上へ移動"
                                                        Command="{Binding DataContext.NavigationPane.MoveFavoriteUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="▼" FontSize="8" Width="18" Height="20" Padding="0" ToolTip="下へ移動"
                                                        Command="{Binding DataContext.NavigationPane.MoveFavoriteDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="✎" FontSize="10" Width="20" Height="20" Padding="0" ToolTip="名前の変更"
                                                        Command="{Binding DataContext.NavigationPane.RenameFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="✕" FontSize="9" Width="20" Height="20" Padding="0" ToolTip="お気に入りから削除"
                                                        Command="{Binding DataContext.NavigationPane.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <Button Content="{Binding Name}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                                    Command="{Binding DataContext.NavigationPane.NavigateToEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⭐" Margin="0,0,6,0" FontSize="11" />
                                                            <TextBlock Text="{Binding}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 最近使った場所（仕様書50章） -->
                            <DockPanel Margin="2,14,0,4">
                                <Button DockPanel.Dock="Right" Content="クリア" FontSize="9" Padding="4,0"
                                        ToolTip="最近使った場所をクリア" Command="{Binding NavigationPane.ClearRecentPlacesCommand}" />
                                <TextBlock Text="最近使った場所" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding NavigationPane.RecentPlaces}" MaxHeight="160"
                                     BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                                     PreviewMouseWheel="NavListBox_PreviewMouseWheel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:FavoriteEntry}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" FontSize="9" Width="20" Height="20" Padding="0"
                                                    ToolTip="一覧から削除"
                                                    Command="{Binding DataContext.NavigationPane.RemoveRecentPlaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{Binding Name}" ToolTip="{Binding Path}"
                                                    HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                                    Command="{Binding DataContext.NavigationPane.NavigateToEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🕘" Margin="0,0,6,0" FontSize="11" />
                                                            <TextBlock Text="{Binding}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 最近開いたプロジェクト（仕様書55章） -->
                            <DockPanel Margin="2,14,0,4">
                                <Button DockPanel.Dock="Right" Content="クリア" FontSize="9" Padding="4,0"
                                        ToolTip="最近のプロジェクトをクリア" Command="{Binding NavigationPane.ClearRecentProjectsCommand}" />
                                <TextBlock Text="最近のプロジェクト" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding NavigationPane.RecentProjects}" MaxHeight="160"
                                     BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                                     PreviewMouseWheel="NavListBox_PreviewMouseWheel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:FavoriteEntry}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" FontSize="9" Width="20" Height="20" Padding="0"
                                                    ToolTip="一覧から削除"
                                                    Command="{Binding DataContext.NavigationPane.RemoveRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{Binding Name}" ToolTip="{Binding Path}"
                                                    HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                                    Command="{Binding DataContext.NavigationPane.NavigateToEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📦" Margin="0,0,6,0" FontSize="11" />
                                                            <TextBlock Text="{Binding}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <DockPanel Margin="2,14,0,4">
                                <Button DockPanel.Dock="Right" Content="+" Width="20" Height="20" Padding="0" FontWeight="Bold"
                                        ToolTip="新しいタグを追加" Command="{Binding AddTagCommand}" />
                                <TextBlock Text="タグ" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding NavigationPane.Tags}"
                                     BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                                     PreviewMouseWheel="NavListBox_PreviewMouseWheel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TagDefinition}">
                                        <DockPanel Margin="4,3">
                                            <Button DockPanel.Dock="Right" Content="✕" FontSize="9" Width="20" Height="20" Padding="0"
                                                    ToolTip="タグを削除"
                                                    Command="{Binding DataContext.NavigationPane.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🏷" Margin="0,0,6,0" FontSize="11" />
                                                <TextBlock Text="{Binding Name}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- ワークスペース（仕様書43章） -->
                            <TextBlock Text="ワークスペース" FontWeight="SemiBold" Margin="2,14,0,4" />
                            <ListBox ItemsSource="{Binding NavigationPane.Workspaces}" MaxHeight="140"
                                     BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                                     PreviewMouseWheel="NavListBox_PreviewMouseWheel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.NavigationPane.LoadWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🗂" Margin="0,0,6,0" FontSize="11" />
                                                        <TextBlock Text="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush2}"
                          Visibility="{Binding NavigationPane.IsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

            <Button Grid.Column="0" Content="»" Width="22" Height="22" Padding="0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4"
                    ToolTip="ナビゲーションペインを表示" Foreground="{DynamicResource TextSecondaryBrush}"
                    Visibility="{Binding NavigationPane.IsCollapsed, Converter={StaticResource BoolToVisibilityConverter}}"
                    Command="{Binding NavigationPane.ToggleCollapsedCommand}" />

            <!-- メインペイン（19章：分割ペイン対応。Panesが2件のときはUniformGridで横/縦に並べる） -->
            <Border Grid.Column="2" Background="{DynamicResource WindowBackgroundBrush}">
                <ItemsControl ItemsSource="{Binding ActiveTab.Panes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding ActiveTab.GridRows}" Columns="{Binding ActiveTab.GridColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PaneViewModel}">
                            <!-- アクティブペインは枠線で明確に表示する（19.2章） -->
                            <Border BorderThickness="2" Margin="1" PreviewMouseDown="PaneContainer_PreviewMouseDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <!-- ペインが2件以上に分割されているときだけアクティブ枠を表示する
                                                 （1ペインのみの通常時に常時青枠が出るのを防ぐ）。 -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsActive}" Value="True" />
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.ActiveTab.ShowPaneBorders}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <!-- 仕様書9章：アクティブペインは枠線だけでなく背景でも強調する（強度は設定で調整可能）。 -->
                                    <Border Background="{DynamicResource AccentBrush}" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsActive}" Value="True" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.ActiveTab.ShowPaneBorders}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Opacity" Value="{DynamicResource ActivePaneHighlightOpacity}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                <Grid AllowDrop="True" DragOver="PaneGrid_DragOver" Drop="PaneGrid_Drop">
                                    <!-- 階層表示 -->
                                    <ListBox x:Name="TreeListBox" ItemsSource="{Binding VisibleNodes}"
                                             Background="Transparent"
                                             SelectionMode="Extended" BorderThickness="0" Padding="6"
                                             ItemContainerStyle="{StaticResource FileRowItemStyle}"
                                             SelectionChanged="TreeListBox_SelectionChanged"
                                             MouseDoubleClick="NodeListBox_MouseDoubleClick"
                                             PreviewKeyDown="TreeListBox_PreviewKeyDown"
                                             PreviewMouseLeftButtonDown="NodeListBox_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="NodeListBox_PreviewMouseMove"
                                             ContextMenu="{StaticResource NodeContextMenu}">
                                        <ListBox.Style>
                                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static models:ViewMode.Tree}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.Style>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:FileSystemNodeViewModel}">
                                                <StackPanel Orientation="Horizontal" Margin="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}">
                                                    <Button Content="{Binding ExpandSymbol}" Width="20" Padding="0" FontFamily="Consolas" FontWeight="Bold"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="14" Margin="2,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <!-- 仕様書21章「Explorer上：M Modified / A Added / D Deleted / U Untracked / R Renamed」。 -->
                                                    <Border Margin="6,0,0,0" Padding="4,0" CornerRadius="2" VerticalAlignment="Center"
                                                            Background="{DynamicResource PanelBackgroundBrush}"
                                                            Visibility="{Binding HasVcsStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding VcsStatus}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding TagsDisplay}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- 詳細表示 -->
                                    <ListView x:Name="DetailListView" ItemsSource="{Binding RootNodes}"
                                              Background="Transparent"
                                              SelectionMode="Extended" BorderThickness="0"
                                              ItemContainerStyle="{StaticResource DetailRowItemStyle}"
                                              SelectionChanged="TreeListBox_SelectionChanged"
                                              MouseDoubleClick="NodeListBox_MouseDoubleClick"
                                              PreviewKeyDown="NodeListBox_PreviewKeyDown"
                                              PreviewMouseLeftButtonDown="NodeListBox_PreviewMouseLeftButtonDown"
                                              PreviewMouseMove="NodeListBox_PreviewMouseMove"
                                              ContextMenu="{StaticResource NodeContextMenu}">
                                        <ListView.Style>
                                            <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static models:ViewMode.Detail}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListView.Style>
                                        <ListView.View>
                                            <GridView>
                                                <GridView.ColumnHeaderContainerStyle>
                                                    <Style TargetType="GridViewColumnHeader">
                                                        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                                                        <Setter Property="Padding" Value="6,6" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Style>
                                                </GridView.ColumnHeaderContainerStyle>
                                                <GridViewColumn Header="名前" Width="260">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:FileSystemNodeViewModel}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding IconGlyph}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="サイズ" Width="90" DisplayMemberBinding="{Binding SizeDisplay}" />
                                                <GridViewColumn Header="更新日時" Width="140" DisplayMemberBinding="{Binding LastModifiedDisplay}" />
                                                <GridViewColumn Header="Git" Width="50" DisplayMemberBinding="{Binding VcsStatus}" />
                                                <GridViewColumn Header="タグ" Width="140" DisplayMemberBinding="{Binding TagsDisplay}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Git/SVN情報ペイン（表示/非表示切り替え可能）。ハンバーガーメニューからも切替できる。 -->
            <GridSplitter Grid.Column="3" Width="3" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush2}"
                          Visibility="{Binding IsVcsPaneVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Border Grid.Column="4" Width="260" Background="{DynamicResource PanelBackgroundBrush}"
                    Visibility="{Binding IsVcsPaneVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel Margin="10" DataContext="{Binding ActiveTab.ActivePane}">
                    <Button DockPanel.Dock="Top" Content="折りたたむ »" HorizontalAlignment="Right"
                            Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                            Command="{Binding DataContext.ToggleVcsPaneCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Git / SVN 情報" FontWeight="SemiBold" Margin="0,14,0,10" />

                        <TextBlock Text="このフォルダはGit/SVN管理下ではありません。" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VcsInfo.Kind}" Value="{x:Static models:VersionControlKind.Git}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VcsInfo.Kind}" Value="{x:Static models:VersionControlKind.Svn}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VcsInfo.Kind}" Value="{x:Static models:VersionControlKind.Git}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VcsInfo.Kind}" Value="{x:Static models:VersionControlKind.Svn}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock FontSize="13" TextWrapping="Wrap">
                                <Run Text="🌿" />
                                <Run Text="{Binding VcsInfo.Kind, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                <Run Text="ブランチ: " Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Run Text="{Binding VcsInfo.BranchName, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Margin="0,12,0,0" Text="状態" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding VcsInfo.StatusSummary, Mode=OneWay}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

                            <!-- 仕様書21章「Log」：直近のコミット履歴。 -->
                            <TextBlock Margin="0,16,0,0" Text="コミット履歴" FontWeight="SemiBold" />
                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding CommitLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:CommitLogEntry}">
                                        <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1"
                                                Padding="0,6" Margin="0,0,0,2">
                                            <StackPanel>
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run Text="{Binding Revision, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" />
                                                    <Run Text="{Binding Author, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Date, Mode=OneWay}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,4,0,0" Text="コミット履歴がありません。"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommitLog.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Button Grid.Column="4" Content="«" Width="22" Height="22" Padding="0" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4"
                    ToolTip="Git/SVN情報ペインを表示" Foreground="{DynamicResource TextSecondaryBrush}"
                    Visibility="{Binding IsVcsPaneVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                    Command="{Binding ToggleVcsPaneCommand}" />
        </Grid>

        <!-- PowerShellターミナル（仕様書17章：複数タブ） -->
        <!-- 注意: Visibilityのバインディング元（TerminalHost.IsVisible）は、この要素の
             「変更前」のDataContext（Window＝MainWindowViewModel）を指す。DataContext自体を
             ここでTerminalHostへ切り替えてしまうと、同じ要素上のVisibilityバインディングも
             新しいDataContext（TerminalHostViewModel）基準で解決されてしまい、
             存在しない"TerminalHost.IsVisible"を探しにいって解決に失敗する
             （＝表示状態がトグルに追従しなくなる不具合の原因だった）。
             そのためDataContextの切り替えは内側のGridで行う。 -->
        <!-- クリックでどこからでも（出力欄を含め）入力欄へフォーカスできるようにする。
             出力欄（TextBox）はクリック時に自分自身へフォーカスを奪う内部処理を持ち、
             かつその処理でイベントをHandled済みにするため、通常のバブリング段階の
             ハンドラーでは出力欄からのクリックを検知できない。トンネリング段階
             （PreviewMouseLeftButtonDown）で検知しつつ、実際のフォーカス移動は
             Dispatcher.BeginInvokeで出力欄自身の既定処理が終わった後に行う。 -->
        <!-- 仕様書3章：ターミナル部分の横幅は、上のGrid.Row="2"と同じSharedSizeGroupで列幅を
             同期させることで、中央（メイン）ペインと同じ幅になるようにする
             （左のナビゲーションペイン・右のGit/SVN情報ペインの下には表示しない）。 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- ナビゲーション/Git・SVNペインが折りたたまれている間は、再展開用の
                     小さな「»」「«」ボタンのために列幅がわずかに残る（Grid.Row="2"側）。
                     ターミナル側にはそのボタンが無いため、SharedSizeGroupにそのまま従うと
                     ターミナルの左右に不要な隙間ができてしまう。折りたたみ中はWidth=0を
                     明示してSharedSizeGroupを上書きし、隙間なく画面端まで広がるようにする。 -->
                <ColumnDefinition SharedSizeGroup="NavPaneColumn">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="Auto" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NavigationPane.IsCollapsed}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition SharedSizeGroup="NavSplitterColumn">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="Auto" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NavigationPane.IsCollapsed}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="*" />
                <ColumnDefinition SharedSizeGroup="VcsSplitterColumn">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="Auto" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVcsPaneVisible}" Value="False">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition SharedSizeGroup="VcsPaneColumn">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="Auto" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVcsPaneVisible}" Value="False">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

        <Border Grid.Column="2" Background="{DynamicResource TerminalBackgroundBrush}"
                Visibility="{Binding TerminalHost.IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                PreviewMouseLeftButtonDown="TerminalPanel_MouseLeftButtonDown">
            <Grid Height="230" DataContext="{Binding TerminalHost}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- タブストリップ。各タブはSync状態を個別に保持する（18章）。 -->
                <DockPanel Grid.Row="0" Margin="8,6,8,0">
                    <Button DockPanel.Dock="Right" Content="＋" Width="26" ToolTip="新しいターミナル"
                            Command="{Binding AddTerminalCommand}" Foreground="{DynamicResource TerminalForegroundBrush}" />
                    <ItemsControl ItemsSource="{Binding Terminals}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,4,0" Padding="8,3" CornerRadius="4"
                                        Background="#2A2A2A" Cursor="Hand"
                                        MouseLeftButtonUp="TerminalTab_MouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource TerminalAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TerminalForegroundBrush}" />
                                        <TextBlock Text=" ✕" Margin="6,0,0,0" Foreground="{DynamicResource TerminalForegroundBrush}"
                                                   MouseLeftButtonUp="TerminalTabClose_MouseLeftButtonUp" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="8,6" DataContext="{Binding ActiveTerminal}">
                    <ToggleButton DockPanel.Dock="Left" Padding="10,4"
                                  IsChecked="{Binding IsSyncEnabled, Mode=TwoWay}"
                                  Content="{Binding IsSyncEnabled, Converter={StaticResource SyncLabelConverter}}"
                                  Foreground="{DynamicResource TerminalForegroundBrush}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0"
                               Foreground="{DynamicResource TerminalForegroundBrush}" FontWeight="SemiBold" />
                </DockPanel>

                <TextBox x:Name="TerminalOutputTextBox" Grid.Row="2" Text="{Binding ActiveTerminal.OutputText, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas"
                         Background="{DynamicResource TerminalBackgroundBrush}" Foreground="{DynamicResource TerminalForegroundBrush}"
                         BorderThickness="0" Margin="8,0" Padding="2"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="TerminalOutputTextBox_TextChanged" />

                <!-- 仕様書19章：ファイル・フォルダをドラッグ＆ドロップするとパスが入力される。 -->
                <Border Grid.Row="3" Background="#2A2A2A" CornerRadius="4" Margin="8,6,8,8" Padding="8,4"
                        AllowDrop="True" DragOver="TerminalInput_DragOver" Drop="TerminalInput_Drop">
                    <DockPanel DataContext="{Binding ActiveTerminal}">
                        <TextBlock DockPanel.Dock="Left" Text="&gt;" Foreground="{DynamicResource TerminalAccentBrush}"
                                   FontFamily="Cascadia Mono,Consolas" Margin="0,0,6,0" />
                        <TextBox x:Name="TerminalInputTextBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono,Consolas" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TerminalForegroundBrush}" CaretBrush="{DynamicResource TerminalForegroundBrush}"
                                 IsVisibleChanged="TerminalInputTextBox_IsVisibleChanged">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
