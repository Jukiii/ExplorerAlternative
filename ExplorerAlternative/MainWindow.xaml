<Window x:Class="ExplorerAlternative.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExplorerAlternative.ViewModels"
        xmlns:models="clr-namespace:ExplorerAlternative.Models"
        xmlns:conv="clr-namespace:ExplorerAlternative.Converters"
        Title="Explorer Alternative"
        Height="760" Width="1280"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:DepthToIndentConverter x:Key="DepthToIndentConverter" />
        <ContextMenu x:Key="NodeContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="開く" Command="{Binding OpenCommand}" />
            <MenuItem Header="新しいフォルダ" Command="{Binding NewFolderCommand}" />
            <Separator />
            <MenuItem Header="コピー" Command="{Binding CopyCommand}" />
            <MenuItem Header="移動 (切り取り)" Command="{Binding CutCommand}" />
            <MenuItem Header="貼り付け" Command="{Binding PasteCommand}" />
            <Separator />
            <MenuItem Header="名前の変更" Command="{Binding RenameCommand}" />
            <MenuItem Header="一括名前変更..." Command="{Binding BulkRenameCommand}" />
            <MenuItem Header="削除" Command="{Binding DeleteCommand}" />
            <Separator />
            <MenuItem Header="外部ツール" ItemsSource="{Binding ExternalTools}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="Command"
                                Value="{Binding DataContext.RunExternalToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Window.InputBindings>
        <!-- Window.InputBindings は論理ツリーに属さずDataContextを継承しないため、
             ElementName経由でWindowのDataContextを明示的に参照する必要がある。
             Spaceキーのみ、ListBox(Extended選択モード)が内部消費してしまうため
             コードビハインドのPreviewKeyDownでトンネリング段階で処理する（MainWindow.xaml.cs参照）。 -->
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding DataContext.GoUpCommand, ElementName=RootWindow}" />
        <KeyBinding Key="OemTilde" Modifiers="Control" Command="{Binding DataContext.ToggleTerminalCommand, ElementName=RootWindow}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タブ行 -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="＋" FontSize="15" Width="34" Margin="4" Padding="0"
                        ToolTip="新しいタブ" Command="{Binding AddTabCommand}" />
                <Menu DockPanel.Dock="Right" Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="☰ メニュー" Padding="8,6">
                        <MenuItem Header="お気に入りに追加" Command="{Binding AddFavoriteCommand}" />
                        <Separator />
                        <MenuItem Header="右に分割" Command="{Binding SplitHorizontalCommand}" />
                        <MenuItem Header="下に分割" Command="{Binding SplitVerticalCommand}" />
                        <MenuItem Header="ペインを閉じる" Command="{Binding ClosePaneCommand}" />
                        <Separator />
                        <MenuItem Header="ワークスペースを保存"
                                  Command="{Binding SaveWorkspaceCommand}"
                                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                        <MenuItem Header="ワークスペースを開く"
                                  Command="{Binding LoadWorkspaceCommand}"
                                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Separator />
                        <MenuItem Header="設定..." Command="{Binding OpenSettingsCommand}" />
                        <MenuItem Header="ショートカット一覧" Command="{Binding OpenCheatSheetCommand}" />
                    </MenuItem>
                </Menu>
                <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource TabItemContainerStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TabViewModel}">
                            <DockPanel Margin="10,6" MinWidth="110" ToolTip="Ctrl+ドラッグで複製"
                                       PreviewMouseLeftButtonDown="TabItem_PreviewMouseLeftButtonDown"
                                       PreviewMouseMove="TabItem_PreviewMouseMove"
                                       PreviewMouseLeftButtonUp="TabItem_PreviewMouseLeftButtonUp">
                                <Button DockPanel.Dock="Right" Content="✕" FontSize="10" Width="20" Height="20" Padding="0"
                                        Margin="8,0,0,0" ToolTip="タブを閉じる"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Text="📁" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="13" />
                                <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ナビゲーション / ツールバー -->
        <Border Grid.Row="1" Background="{StaticResource ToolbarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,6" LastChildFill="True"
                       DataContext="{Binding ActiveTab.ActivePane}">
                <Button DockPanel.Dock="Left" Content="⬆" FontSize="14" Width="30" Padding="0" ToolTip="親フォルダへ移動 (Alt+↑)"
                        Command="{Binding GoUpCommand}" />

                <Border DockPanel.Dock="Right" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="5"
                        Margin="10,0,0,0" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="詳細" Padding="10,4"
                                      IsChecked="{Binding CurrentViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ViewMode.Detail}, Mode=OneWay}"
                                      Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ViewMode.Detail}" />
                        <ToggleButton Content="階層" Padding="10,4" Margin="2,0,0,0"
                                      IsChecked="{Binding CurrentViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:ViewMode.Tree}, Mode=OneWay}"
                                      Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ViewMode.Tree}" />
                    </StackPanel>
                </Border>

                <Border Margin="10,0,0,0" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="5" Padding="6,0">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAddressEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding BreadcrumbSegments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BreadcrumbSegmentViewModel}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding DisplayName}" Command="{Binding NavigateCommand}"
                                                    Padding="6,4" />
                                            <ToggleButton Content="⌄" Width="18" Padding="0"
                                                          IsChecked="{Binding IsDropdownOpen, Mode=TwoWay}" />
                                            <Popup IsOpen="{Binding IsDropdownOpen, Mode=TwoWay}" StaysOpen="False" Placement="Bottom">
                                                <Border Background="{StaticResource WindowBackgroundBrush}"
                                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                                        CornerRadius="4" Padding="2">
                                                    <ListBox ItemsSource="{Binding DropdownItems}" MaxHeight="240" MinWidth="160"
                                                             BorderThickness="0">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:BreadcrumbDropdownItem}">
                                                                <Button Content="{Binding Name}" Command="{Binding NavigateCommand}"
                                                                        HorizontalContentAlignment="Left"
                                                                        HorizontalAlignment="Stretch" />
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Border>
                                            </Popup>
                                            <TextBlock Text="/" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="✎" Width="24" Padding="0" ToolTip="パスを編集" Foreground="{StaticResource TextSecondaryBrush}"
                                    Command="{Binding BeginAddressEditCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBox Text="{Binding AddressEditText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Margin="10,0,0,0" Padding="6,4"
                         BorderBrush="{StaticResource AccentBrush}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAddressEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding DataContext.ActiveTab.ActivePane.CommitAddressEditCommand, ElementName=RootWindow}" />
                        <KeyBinding Key="Escape" Command="{Binding DataContext.ActiveTab.ActivePane.CancelAddressEditCommand, ElementName=RootWindow}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- Git/SVN情報 -->
        <Border Grid.Row="2" Background="#EEF7EE" Padding="10,5"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1"
                DataContext="{Binding ActiveTab.ActivePane}"
                Visibility="{Binding VcsInfo.Kind, Converter={StaticResource VcsKindToVisibilityConverter}}">
            <TextBlock FontSize="12">
                <Run Text="🌿" />
                <Run Text="{Binding VcsInfo.Kind, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="ブランチ:" Foreground="{StaticResource TextSecondaryBrush}" />
                <Run Text="{Binding VcsInfo.BranchName, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="  " />
                <Run Text="{Binding VcsInfo.StatusSummary, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
            </TextBlock>
        </Border>

        <!-- ナビゲーションペイン + メインペイン -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ナビゲーションペイン -->
            <Border Grid.Column="0" Width="210" Background="{StaticResource PanelBackgroundBrush}"
                    Visibility="{Binding NavigationPane.IsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <DockPanel Margin="10">
                    <Button DockPanel.Dock="Top" Content="« 折りたたむ" HorizontalAlignment="Left"
                            Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                            Command="{Binding NavigationPane.ToggleCollapsedCommand}" />

                    <TextBlock DockPanel.Dock="Top" Text="お気に入り" FontWeight="SemiBold" Margin="2,14,0,4" />
                    <ListBox DockPanel.Dock="Top" ItemsSource="{Binding NavigationPane.Favorites}" MaxHeight="200"
                             BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource NavListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:FavoriteEntry}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕" FontSize="9" Width="20" Height="20" Padding="0"
                                            Command="{Binding DataContext.NavigationPane.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="{Binding Name}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.NavigationPane.NavigateToFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⭐" Margin="0,0,6,0" FontSize="11" />
                                                    <TextBlock Text="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock DockPanel.Dock="Top" Text="タグ" FontWeight="SemiBold" Margin="2,14,0,4" />
                    <ListBox DockPanel.Dock="Top" ItemsSource="{Binding NavigationPane.Tags}"
                             BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource NavListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TagDefinition}">
                                <StackPanel Orientation="Horizontal" Margin="4,3">
                                    <TextBlock Text="🏷" Margin="0,0,6,0" FontSize="11" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush2}"
                          Visibility="{Binding NavigationPane.IsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

            <Button Grid.Column="0" Content="»" Width="22" Height="22" Padding="0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4"
                    ToolTip="ナビゲーションペインを表示" Foreground="{StaticResource TextSecondaryBrush}"
                    Visibility="{Binding NavigationPane.IsCollapsed, Converter={StaticResource BoolToVisibilityConverter}}"
                    Command="{Binding NavigationPane.ToggleCollapsedCommand}" />

            <!-- メインペイン（19章：分割ペイン対応。Panesが2件のときはUniformGridで横/縦に並べる） -->
            <Border Grid.Column="2" Background="{StaticResource WindowBackgroundBrush}">
                <ItemsControl ItemsSource="{Binding ActiveTab.Panes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding ActiveTab.GridRows}" Columns="{Binding ActiveTab.GridColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PaneViewModel}">
                            <!-- アクティブペインは枠線で明確に表示する（19.2章） -->
                            <Border BorderThickness="2" Margin="1" PreviewMouseDown="PaneContainer_PreviewMouseDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <!-- ペインが2件以上に分割されているときだけアクティブ枠を表示する
                                                 （1ペインのみの通常時に常時青枠が出るのを防ぐ）。 -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsActive}" Value="True" />
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.ActiveTab.ShowPaneBorders}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid AllowDrop="True">
                                    <!-- 階層表示 -->
                                    <ListBox x:Name="TreeListBox" ItemsSource="{Binding VisibleNodes}"
                                             SelectionMode="Extended" BorderThickness="0" Padding="6"
                                             ItemContainerStyle="{StaticResource FileRowItemStyle}"
                                             SelectionChanged="TreeListBox_SelectionChanged"
                                             MouseDoubleClick="NodeListBox_MouseDoubleClick"
                                             ContextMenu="{StaticResource NodeContextMenu}">
                                        <ListBox.Style>
                                            <Style TargetType="ListBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static models:ViewMode.Tree}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.Style>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:FileSystemNodeViewModel}">
                                                <StackPanel Orientation="Horizontal" Margin="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}">
                                                    <Button Content="{Binding ExpandSymbol}" Width="20" Padding="0" FontFamily="Consolas" FontWeight="Bold"
                                                            Foreground="{StaticResource TextSecondaryBrush}"
                                                            Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="14" Margin="2,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- 詳細表示 -->
                                    <ListView x:Name="DetailListView" ItemsSource="{Binding RootNodes}"
                                              SelectionMode="Extended" BorderThickness="0"
                                              ItemContainerStyle="{StaticResource DetailRowItemStyle}"
                                              SelectionChanged="TreeListBox_SelectionChanged"
                                              MouseDoubleClick="NodeListBox_MouseDoubleClick"
                                              ContextMenu="{StaticResource NodeContextMenu}">
                                        <ListView.Style>
                                            <Style TargetType="ListView">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static models:ViewMode.Detail}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListView.Style>
                                        <ListView.View>
                                            <GridView>
                                                <GridView.ColumnHeaderContainerStyle>
                                                    <Style TargetType="GridViewColumnHeader">
                                                        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
                                                        <Setter Property="Padding" Value="6,6" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Style>
                                                </GridView.ColumnHeaderContainerStyle>
                                                <GridViewColumn Header="名前" Width="260">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:FileSystemNodeViewModel}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding IconGlyph}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="サイズ" Width="90" DisplayMemberBinding="{Binding SizeDisplay}" />
                                                <GridViewColumn Header="更新日時" Width="140" DisplayMemberBinding="{Binding LastModifiedDisplay}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <!-- PowerShellターミナル -->
        <Border Grid.Row="4" Background="{StaticResource TerminalBackgroundBrush}"
                Visibility="{Binding Terminal.IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Height="230">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="8,6">
                    <ToggleButton DockPanel.Dock="Left" Padding="10,4"
                                  IsChecked="{Binding Terminal.IsSyncEnabled, Mode=TwoWay}"
                                  Content="{Binding Terminal.IsSyncEnabled, Converter={StaticResource SyncLabelConverter}}"
                                  Foreground="{StaticResource TerminalForegroundBrush}" />
                    <TextBlock Text="PowerShell Terminal" VerticalAlignment="Center" Margin="10,0"
                               Foreground="{StaticResource TerminalForegroundBrush}" FontWeight="SemiBold" />
                </DockPanel>

                <TextBox x:Name="TerminalOutputTextBox" Grid.Row="1" Text="{Binding Terminal.OutputText, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas"
                         Background="{StaticResource TerminalBackgroundBrush}" Foreground="{StaticResource TerminalForegroundBrush}"
                         BorderThickness="0" Margin="8,0" Padding="2"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="TerminalOutputTextBox_TextChanged" />

                <Border Grid.Row="2" Background="#2A2A2A" CornerRadius="4" Margin="8,6,8,8" Padding="8,4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&gt;" Foreground="{StaticResource TerminalAccentBrush}"
                                   FontFamily="Cascadia Mono,Consolas" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Terminal.InputText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono,Consolas" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TerminalForegroundBrush}" CaretBrush="{StaticResource TerminalForegroundBrush}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding DataContext.Terminal.SendCommand, ElementName=RootWindow}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
