<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 2026-09更新：ユーザー指示により、配色をClaude.ai風の暖色系（オレンジ系アクセント・
         クリーム色の背景）に変更した。ターミナル・Diff・VCSバナー等の意味を持つ色
         （緑=追加、赤=削除等）はそのまま維持している。 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FAF9F5" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F0EEE4" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#F5F3EA" />
    <SolidColorBrush x:Key="BorderBrush2" Color="#DEDACB" />
    <SolidColorBrush x:Key="AccentBrush" Color="#CC7A5C" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#F2DDD3" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EAE6D8" />
    <SolidColorBrush x:Key="PressedBrush" Color="#DCD6C4" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#3D3929" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#78735F" />
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#D4D4D4" />
    <SolidColorBrush x:Key="TerminalAccentBrush" Color="#3DDC97" />
    <SolidColorBrush x:Key="VcsBannerBackgroundBrush" Color="#EEF7EE" />
    <SolidColorBrush x:Key="DiffRemovedBackgroundBrush" Color="#FBDCDC" />
    <SolidColorBrush x:Key="DiffAddedBackgroundBrush" Color="#DCF5DC" />
</ResourceDictionary>
